# Copie para .env e ajuste os valores. Nunca versione o .env.
# Gere uma chave com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=troque-esta-chave
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Origem do servidor Node/Express que faz proxy de /api (necessario para o CSRF).
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Taxa maxima de tentativas de login por IP (API e /admin/login/).
LOGIN_THROTTLE_RATE=5/min
ADMIN_LOGIN_THROTTLE_RATE=5/min
# Numero de proxies confiaveis na frente do Django (identificacao do IP no
# rate limit).
#   0 (padrao): usa REMOTE_ADDR e ignora X-Forwarded-For (seguro quando o
#               Django e acessado diretamente).
#   1: atras do Express com proxy xfwd: true. Nesse caso o Django DEVE escutar
#      somente em 127.0.0.1 (runserver 127.0.0.1:8000 / gunicorn -b
#      127.0.0.1:8000); se a porta 8000 ficar exposta, o cliente pode forjar
#      X-Forwarded-For e burlar o rate limit.
NUM_PROXIES=0
# Cache usado pelo rate limit. LocMem (padrao) e por processo: ok em dev.
# Em producao com varios workers use um cache compartilhado, ex.:
#   CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
#   CACHE_LOCATION=/var/tmp/financeiro_cache
# (ou Redis: django.core.cache.backends.redis.RedisCache + redis://127.0.0.1:6379/1)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=
# Producao (usados quando DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
