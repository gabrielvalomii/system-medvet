# Porta do servidor Express
PORT=3000
# URL do Django (deve escutar só em 127.0.0.1; o back roda com NUM_PROXIES=1)
API_URL=http://127.0.0.1:8000

# Credenciais de um usuário de TESTE, usadas apenas pelo Playwright (npm run test:e2e).
# Crie no back: python manage.py shell -c "from accounts.models import User; User.objects.create_user(email='qa@example.com', password='SenhaForte#2026')"
E2E_EMAIL=qa@example.com
# Entre aspas: "#" sem aspas inicia um comentário no .env
E2E_PASSWORD="SenhaForte#2026"
