{
  "name": "financeiro-front",
  "version": "1.0.0",
  "private": true,
  "description": "Front-end do controle financeiro pessoal (Express + HTML/CSS/JS)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.13"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  }
}
